{
  "name": "recap-cli",
  "version": "0.1.0",
  "description": "Turn your GitLab merge requests and Jira issues into a paste-ready standup digest.",
  "keywords": [
    "standup",
    "cli",
    "gitlab",
    "jira",
    "digest",
    "eod"
  ],
  "license": "MIT",
  "author": "belimm01",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belimm01/recap.git"
  },
  "homepage": "https://github.com/belimm01/recap#readme",
  "bugs": {
    "url": "https://github.com/belimm01/recap/issues"
  },
  "type": "module",
  "bin": {
    "recap": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "biome check src test",
    "format": "biome check --write src test",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
