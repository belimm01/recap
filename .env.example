# Copy to .env and fill in. recap reads whichever providers are configured
# and quietly skips the ones that aren't.

# --- GitLab ---
# Works with gitlab.com or a self-hosted instance.
GITLAB_URL=https://gitlab.com
# Personal access token with the `read_api` scope.
GITLAB_TOKEN=

# --- Jira ---
# Cloud:  https://your-org.atlassian.net   (JIRA_USER = your account email)
# Server: https://jira.your-company.com    (JIRA_USER = your username)
JIRA_URL=
JIRA_USER=
JIRA_TOKEN=
